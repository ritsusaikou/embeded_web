---
// 部署链路示意图：纯内联 SVG，零 JS，跟随站点配色
const nodes = [
  {
    title: '浏览器',
    sub: '答辩老师 · 手机 · 笔记本',
    fill: '#ffffff',
    stroke: '#dbdbdb',
    y: 32
  },
  {
    title: 'Nginx（公网服务器）',
    sub: '443 终止 TLS · 反向代理 · 缓存头',
    fill: '#e6f1fb',
    stroke: '#185fa5',
    y: 132
  },
  {
    title: 'frps（公网服务器）',
    sub: '仅监听 127.0.0.1:8080，不对公网暴露',
    fill: '#e6f1fb',
    stroke: '#185fa5',
    y: 232
  },
  {
    title: 'frpc（开发板）',
    sub: '常驻约 10MB · 断线自动重连',
    fill: '#e1f5ee',
    stroke: '#0f6e56',
    y: 332
  },
  {
    title: 'Nginx（开发板 :80）',
    sub: '1 worker · 常驻 3.2MB · gzip_static',
    fill: '#e1f5ee',
    stroke: '#0f6e56',
    y: 432
  },
  {
    title: 'dist/ 静态文件',
    sub: 'HTML + CSS · 约 8KB/页 · 0 KB 框架 JS',
    fill: '#e1f5ee',
    stroke: '#0f6e56',
    y: 532
  }
];

const links = [
  { label: 'HTTPS · 443', dashed: false },
  { label: 'proxy_pass · 127.0.0.1:8080', dashed: false },
  { label: 'frp 反向隧道（板子主动外连，隧道内加密）', dashed: true },
  { label: '127.0.0.1:80', dashed: false },
  { label: 'read() + sendfile()', dashed: false }
];
---

<svg viewBox="0 0 680 608" width="100%" role="img" aria-label="从浏览器到开发板的完整请求链路">
  <defs>
    <marker
      id="arch-arrow"
      viewBox="0 0 10 10"
      refX="8"
      refY="5"
      markerWidth="6"
      markerHeight="6"
      orient="auto-start-reverse"
    >
      <path
        d="M2 1L8 5L2 9"
        fill="none"
        stroke="context-stroke"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </marker>
  </defs>

  {nodes.map((n) => (
    <>
      <rect
        x="150"
        y={n.y}
        width="380"
        height="56"
        rx="10"
        fill={n.fill}
        stroke={n.stroke}
        stroke-width="0.8"
      />
      <text x="172" y={n.y + 24} font-size="14.5" font-weight="600" fill="#141414">
        {n.title}
      </text>
      <text x="172" y={n.y + 42} font-size="12" fill="#6b6b6b">
        {n.sub}
      </text>
    </>
  ))}

  {links.map((l, i) => {
    const y0 = nodes[i].y + 56;
    const stroke = l.dashed ? '#0f6e56' : '#9aa0a6';
    return (
      <>
        <path
          d={`M340 ${y0} L340 ${y0 + 40}`}
          fill="none"
          stroke={stroke}
          stroke-width={l.dashed ? 1.4 : 1.2}
          stroke-dasharray={l.dashed ? '4 4' : undefined}
          marker-end="url(#arch-arrow)"
        />
        <text x="354" y={y0 + 24} font-size="11.5" fill="#909090">
          {l.label}
        </text>
      </>
    );
  })}
</svg>
