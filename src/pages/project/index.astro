---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import ArchDiagram from '../../components/ArchDiagram.astro';
import Icon from '../../components/Icon.astro';
import { site, snapshot } from '../../data/site';

const steps = [
  {
    n: '01',
    title: '构建',
    desc: '在 PC 上执行 npm run build。Astro 把 Markdown 与组件渲染成纯 HTML / CSS，产物进 dist/。'
  },
  {
    n: '02',
    title: '预压缩',
    desc: '构建时把 html / css 各生成一份 .gz，板上 Nginx 直接用 gzip_static 发，省掉 A7 的压缩开销。'
  },
  {
    n: '03',
    title: '同步',
    desc: 'rsync 增量上传 dist/ 到板子的 /var/www/site。板上不装 Node，也不在板上构建。'
  },
  {
    n: '04',
    title: '穿透',
    desc: 'frpc 主动连服务器的 frps，服务器 Nginx 把 443 反代到隧道端口，TLS 在服务器终结。'
  }
];

const deployCmd = `# 1. PC 上构建（绝不要在板子上跑 dev / build）
npm run build

# 2. 预压缩，省掉板子上每次请求的 gzip 开销
find dist -type f \\( -name '*.html' -o -name '*.css' \\) -exec gzip -9 -k {} \\;

# 3. 只上传产物
rsync -avz --delete dist/ root@192.168.1.50:/var/www/site/

# 4. 重载 Nginx
ssh root@192.168.1.50 "nginx -s reload"`;

const boardNginx = `server {
    listen 80;
    server_name _;
    root /var/www/site;
    index index.html;

    sendfile  on;
    tcp_nopush on;

    gzip off;          # 关掉运行时压缩
    gzip_static on;    # 直接发构建时生成的 .gz

    access_log off;    # 减少 SD 卡写入

    location / {
        try_files $uri $uri/ $uri.html =404;
        expires 7d;
    }
}`;

const frpcToml = `serverAddr = "服务器公网 IP"
serverPort = 7000
auth.method = "token"
auth.token = "换成一串随机字符串"
transport.tls.enable = true
transport.heartbeatInterval = 10
transport.heartbeatTimeout = 30

[[proxies]]
name      = "board-web"
type      = "tcp"
localIP   = "127.0.0.1"
localPort = 80
remotePort = 8080`;

const serverNginx = `server {
    listen 443 ssl http2;
    server_name imx6ull.example.com;

    ssl_certificate     /etc/letsencrypt/live/xxx/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/xxx/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8080;   # frps 映射端口
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}`;

const keyPoints = [
  {
    icon: 'check',
    t: 'HTTPS 只在公网服务器上终结',
    d: '板子只出 HTTP。证书私钥不放在随手会被拔电的开发板上，也避开了 ACME 校验需要 80 端口对外的矛盾。'
  },
  {
    icon: 'check',
    t: 'frps 的回连端口只绑 127.0.0.1',
    d: 'proxyBindAddr 必须设成本机，否则任何人都能绕过 Nginx 直连 8080，甚至把服务当跳板。'
  },
  {
    icon: 'check',
    t: '不在板子上构建',
    d: 'Node 在 armhf 上构建一个站点峰值内存超过 500MB，512MB 的板子必然 OOM。构建一律在 PC 完成。'
  },
  {
    icon: 'check',
    t: '板上关日志、开 gzip_static',
    d: 'access_log off 减少 SD 卡写入；预压缩把单请求 CPU 从 4.1ms 压到 0.4ms，吞吐提升约 80%。'
  }
];
---

<Base title="课程项目" description="把静态站点跑在 i.MX6ULL 开发板上，经 frp 反向隧道发布到公网域名：架构、部署流程、关键配置与实测数据。">
  <section class="page-head">
    <div class="container">
      <div class="crumbs">
        <a href="/">首页</a><span>/</span><span>课程项目</span>
      </div>
      <h1>课程项目 · 用开发板做一个网站</h1>
      <p>
        项目要求：在 i.MX6ULL 开发板上部署一个网站，通过没有公网 IP 的校园网出口，
        发布到自己的域名上。本站就是这个项目的交付物——你正在浏览的页面，
        此刻由一块 512MB 内存的开发板提供。
      </p>
      <div class="card__tags" style="margin-top:16px;">
        <span class="badge badge--ok">已上线</span>
        <span class="tag">Astro 静态构建</span>
        <span class="tag">Nginx</span>
        <span class="tag">frp 内网穿透</span>
        <span class="tag">TLS 终结</span>
      </div>
    </div>
  </section>

  <!-- 概览 -->
  <section class="section">
    <div class="container grid-2" style="gap:56px; align-items:start;">
      <div>
        <span class="eyebrow">项目概述</span>
        <h2 style="margin:14px 0 18px;">约束很硬：512MB、单核、没有公网 IP</h2>
        <div class="stack-16" style="font-size:15px; color:var(--ink-3);">
          <p>
            第一反应是「装个 Node 跑 SSR」。算一下账就放弃了：在 armhf 上跑一个 Node 服务，
            常驻内存 60–120MB，占掉 512MB 的五分之一，而这五分之一换来的能力——
            服务端渲染——这个站点根本用不上。内容全是 Markdown，构建时就能确定。
          </p>
          <p>
            于是架构定成：<strong>PC 上构建，开发板只做静态文件服务，公网服务器只做证书与入口。</strong>
            最终板上常驻的只有一个 Nginx worker，3.2MB。
          </p>
          <p>
            第二个难题是网络。实验室出口是校园网 NAT，没有公网 IP，也没法做端口映射。
            用 frp 从内侧建立反向隧道：板子主动外连服务器，服务器收到请求后顺着这条已有
            连接转发回来。因为出站连接本来就是允许的，NAT 拦不住。
          </p>
        </div>
      </div>

      <div class="card" style="padding:26px;">
        <div class="card__num">PROJECT INFO</div>
        <dl class="info">
          <dt>项目名称</dt><dd>基于 i.MX6ULL 的轻量级站点托管</dd>
          <dt>运行平台</dt><dd>{site.board}</dd>
          <dt>内存约束</dt><dd>512 MB</dd>
          <dt>板上常驻</dt><dd>nginx 3.2MB + frpc 10MB</dd>
          <dt>发布方式</dt><dd>frp 反向隧道 + 公网 Nginx</dd>
          <dt>TLS</dt><dd>Let's Encrypt，服务器终结</dd>
          <dt>访问地址</dt><dd class="mono">{site.domain}</dd>
          <dt>源码</dt>
          <dd><a href={site.github} target="_blank" rel="noopener">github.com ↗</a></dd>
        </dl>
      </div>
    </div>
  </section>

  <!-- 架构 -->
  <section class="section section--soft">
    <div class="container">
      <SectionHead
        eyebrow="架构"
        title="一次请求要经过六跳"
        desc="每一跳的职责都很单一。出问题时可以逐跳验证：先看 DNS，再看 443，再看隧道是否连通，最后才怀疑板子。"
      />
      <div class="arch-wrap">
        <div class="arch-svg"><ArchDiagram /></div>
        <div class="arch-notes">
          {keyPoints.map((p) => (
            <div class="arch-note">
              <span class="arch-note__icon"><Icon name={p.icon} size={15} /></span>
              <div>
                <div class="arch-note__t">{p.t}</div>
                <div class="arch-note__d">{p.d}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 部署流程 -->
  <section class="section">
    <div class="container">
      <SectionHead
        eyebrow="部署流程"
        title="从改一个 Markdown 到线上生效，四步"
        desc="整个流程一条命令，不需要插拔 SD 卡，也不需要登录板子手工操作。"
      />
      <div class="steps">
        {steps.map((s) => (
          <div class="step">
            <span class="step__n">{s.n}</span>
            <div class="step__t">{s.title}</div>
            <div class="step__d">{s.desc}</div>
          </div>
        ))}
      </div>

      <div class="code-grid">
        <div>
          <div class="code-label">PC 端 · 一条命令完成构建与发布</div>
          <pre class="code"><code>{deployCmd}</code></pre>
        </div>
        <div>
          <div class="code-label">开发板 · /etc/nginx/conf.d/site.conf</div>
          <pre class="code"><code>{boardNginx}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- 穿透配置 -->
  <section class="section section--soft">
    <div class="container">
      <SectionHead
        eyebrow="内网穿透"
        title="两端配置，一进一出"
        desc="板子侧发起连接，服务器侧决定谁可以访问。方向搞反了会一直 502。"
      />
      <div class="code-grid">
        <div>
          <div class="code-label">开发板 · /etc/frp/frpc.toml</div>
          <pre class="code"><code>{frpcToml}</code></pre>
        </div>
        <div>
          <div class="code-label">公网服务器 · Nginx 站点</div>
          <pre class="code"><code>{serverNginx}</code></pre>
        </div>
      </div>
      <p class="small" style="margin-top:18px;">
        完整推导与踩坑记录见
        <a href="/notes/02-frp-tunnel/" style="color:var(--brand-dark);">《内网穿透方案对比与 frp 落地》</a>，
        性能数据见
        <a href="/notes/04-performance/" style="color:var(--brand-dark);">《性能实测》</a>。
      </p>
    </div>
  </section>

  <!-- 实时状态 -->
  <section class="section">
    <div class="container">
      <SectionHead
        eyebrow="运行证明"
        title="此刻板子的状态"
        desc="一组由板上脚本定时采集的指标，用于证明页面确实由开发板提供。"
        href="/status/"
        linkText="查看状态说明"
      />
      <div class="metrics">
        <div class="metrics__item">
          <div class="metrics__num">{snapshot.kernel}</div>
          <div class="metrics__label">内核版本</div>
        </div>
        <div class="metrics__item">
          <div class="metrics__num">{snapshot.mem}</div>
          <div class="metrics__label">内存占用</div>
        </div>
        <div class="metrics__item">
          <div class="metrics__num">{snapshot.nginx}</div>
          <div class="metrics__label">Nginx 进程</div>
        </div>
        <div class="metrics__item">
          <div class="metrics__num">{snapshot.uptime}</div>
          <div class="metrics__label">连续运行</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 待补素材 -->
  <section class="section section--soft">
    <div class="container">
      <SectionHead
        eyebrow="素材预留"
        title="演示材料（待补）"
        desc="以下位置已预留，完成拍摄与录制后直接替换占位内容。"
      />
      <div class="cards">
        <div class="placeholder">
          <strong>上电演示视频</strong>
          板子通电 → 串口启动日志 → 浏览器打开域名 → 页面加载完成
        </div>
        <div class="placeholder">
          <strong>实物照片</strong>
          开发板、网线、供电与屏幕指示灯，附接线说明
        </div>
        <div class="placeholder">
          <strong>板上 top 截图</strong>
          压测时的 CPU 与内存占用，配合性能实测数据
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container">
      <div class="cta">
        <div>
          <h3>线上站点与源码</h3>
          <p class="muted" style="margin-top:8px; font-size:14px;">
            站点经 frp 隧道发布，域名见仓库 <span class="mono">astro.config.mjs</span> 的
            <span class="mono">site</span> 字段。源码包含全部内容与部署脚本。
          </p>
        </div>
        <div class="cta__actions">
          <a class="btn btn--primary" href={`https://${site.domain}`} target="_blank" rel="noopener">
            访问线上站点 ↗
          </a>
          <a class="btn btn--ghost" href={site.github} target="_blank" rel="noopener">GitHub 仓库</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .info {
    display: grid;
    grid-template-columns: 76px 1fr;
    gap: 11px 14px;
    font-size: 13.5px;
    margin: 0;
  }
  .info dt {
    color: var(--muted);
  }
  .info dd {
    margin: 0;
    color: var(--ink);
  }
  .info a {
    color: var(--brand-dark);
  }

  .arch-wrap {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 48px;
    align-items: center;
  }
  .arch-svg {
    padding: 20px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
  }
  .arch-note {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: 12px;
    padding: 18px 0;
    border-top: 1px solid var(--line-2);
  }
  .arch-note:last-child {
    border-bottom: 1px solid var(--line-2);
  }
  .arch-note__icon {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #eafaf1;
    color: #087443;
    display: grid;
    place-items: center;
    margin-top: 2px;
  }
  .arch-note__t {
    font-size: 14.5px;
    font-weight: 600;
  }
  .arch-note__d {
    font-size: 13.5px;
    color: var(--ink-3);
    margin-top: 4px;
    line-height: 1.65;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 32px;
  }
  .step {
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: 20px;
    background: #fff;
  }
  .step__n {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--brand);
  }
  .step__t {
    font-size: 15px;
    font-weight: 600;
    margin: 8px 0 6px;
  }
  .step__d {
    font-size: 13px;
    color: var(--ink-3);
    line-height: 1.65;
  }

  .code-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    align-items: start;
  }
  .code-label {
    font-size: 12px;
    font-family: var(--mono);
    color: var(--muted);
    margin-bottom: 8px;
  }
  .code {
    background: var(--navy);
    color: #dbe3ec;
    border-radius: var(--r);
    padding: 18px 20px;
    overflow-x: auto;
    font-size: 12.4px;
    line-height: 1.8;
    margin: 0;
  }
  .code code {
    font-family: var(--mono);
    white-space: pre;
  }
  .cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 30px 34px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: linear-gradient(120deg, var(--brand-soft), #fff 60%);
  }
  .cta__actions {
    display: flex;
    gap: 10px;
    flex: none;
  }

  @media (max-width: 1000px) {
    .arch-wrap,
    .code-grid {
      grid-template-columns: 1fr;
    }
    .arch-svg {
      max-width: 480px;
      margin-inline: auto;
    }
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 720px) {
    .steps {
      grid-template-columns: 1fr;
    }
    .cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
