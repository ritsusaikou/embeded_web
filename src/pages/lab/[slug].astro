---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const labs = (await getCollection('lab')).sort((a, b) => a.data.order - b.data.order);
  return labs.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: labs[i - 1] ?? null, next: labs[i + 1] ?? null }
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const fmt = (date: Date) =>
  `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}.${String(date.getDate()).padStart(2, '0')}`;
---

<Base title={d.title} description={d.summary}>
  <section class="page-head">
    <div class="container">
      <div class="crumbs">
        <a href="/">首页</a><span>/</span><a href="/lab/">实验日志</a><span>/</span>
        <span>L{String(d.order).padStart(2, '0')}</span>
      </div>
      <h1 style="font-size:clamp(24px,2.6vw,32px); max-width:22em;">{d.title}</h1>
      <p>{d.summary}</p>
      <div class="card__tags" style="margin-top:16px;">
        <span class="badge badge--ok">{d.week}</span>
        {d.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </div>
  </section>

  <div class="container">
    <div class="detail">
      <article class="prose">
        <Content />
      </article>

      <aside class="side">
        <h4>实验信息</h4>
        <dl>
          <dt>序号</dt><dd>第 {d.order} 次</dd>
          <dt>日期</dt><dd>{fmt(d.date)}</dd>
          <dt>学时</dt><dd>{d.duration}</dd>
          <dt>状态</dt><dd>已完成</dd>
        </dl>

        {d.hardware.length > 0 && (
          <>
            <h4 style="margin-top:22px;">硬件</h4>
            <div class="card__tags">
              {d.hardware.map((h) => <span class="tag">{h}</span>)}
            </div>
          </>
        )}

        <h4 style="margin-top:22px;">相关链接</h4>
        <ul class="side-links">
          <li><a href="/docs/">系统设计文档 <span>→</span></a></li>
          <li><a href="/source/">源码与产物 <span>→</span></a></li>
          <li><a href="/notes/">技术选型 <span>→</span></a></li>
        </ul>
      </aside>
    </div>

    <div class="pager">
      <div>
        {prev && (
          <a href={`/lab/${prev.id}/`}>
            ← 上一次 · {prev.data.title}
          </a>
        )}
      </div>
      <div class="pager__next">
        {next ? (
          <a href={`/lab/${next.id}/`}>下一次 · {next.data.title} →</a>
        ) : (
          <a href="/lab/">返回实验列表 →</a>
        )}
      </div>
    </div>
  </div>
</Base>

<style>
  .side-links li + li {
    margin-top: 10px;
  }
  .side-links a {
    display: flex;
    justify-content: space-between;
    font-size: 13.5px;
    color: var(--ink-2);
  }
  .side-links a:hover {
    color: var(--brand);
  }
  .pager {
    padding-bottom: 72px;
  }
</style>
