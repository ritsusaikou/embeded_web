---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import { snapshot, site } from '../../data/site';

const fields = [
  ['host', '主机名', snapshot.host, 'uname().nodename'],
  ['kernel', '内核版本', snapshot.kernel, 'uname().release'],
  ['uptime', '连续运行', snapshot.uptime, '/proc/uptime'],
  ['cpu', 'CPU / 负载', '—', '/proc/stat · /proc/loadavg'],
  ['temp', 'SoC 温度', '—', '/sys/class/thermal/thermal_zone0'],
  ['mem', '内存占用', snapshot.mem, '/proc/meminfo'],
  ['disk', '根分区', '—', 'statvfs("/")'],
  ['nginx', 'Nginx 进程', snapshot.nginx, '/proc/*/comm'],
  ['tunnel', '隧道状态', snapshot.tunnel, '/var/lib/frpc/frpc.log'],
  ['procs', '进程数', '—', '/proc 目录计数'],
  ['net', '网卡流量', '—', '/proc/net/dev'],
  ['collectedAt', '采集时间', snapshot.collectedAt, 'time.strftime']
];

const snippet = `# board-agent.py · /api/status 的核心（节选）
def collect_status():
    up = float(open('/proc/uptime').read().split()[0])
    mem = {}                       # MemTotal / MemAvailable 全是 kB
    for line in open('/proc/meminfo'):
        k, _, v = line.partition(':')
        mem[k] = int(v.split()[0])

    used = mem['MemTotal'] - mem['MemAvailable']
    total_proc, names = scan_proc()        # 扫 /proc，顺便数 nginx / frpc

    return {
        'uptime': int(up),
        'uptime_h': fmt_uptime(up),
        'load': loadavg(),
        'cpu': cpu_percent(),              # /proc/stat 两次采样的差值
        'temp': read('/sys/class/thermal/thermal_zone0/temp') / 1000.0,
        'mem': {'total': mem['MemTotal'] // 1024,
                'used': used // 1024,
                'pct': round(100.0 * used / mem['MemTotal'], 1)},
        'disk': statvfs_root(),
        'net': net_bytes('eth0'),
        'nginx': {'running': names.get('nginx', 0),
                  'workers': names.get('nginx', 0) - 1},
        'tunnel': tunnel_state(names),     # 读 frpc.log 最后几行判断
        'procs': total_proc,
        'ts': int(time.time()),
    }`;

const why = [
  {
    t: '定时写 status.json',
    d: '零常驻，前端只请求一个静态文件。缺点是每个周期都要写 SD 卡，而且数据永远滞后一个周期。',
    bad: '200 字节 JSON × 每天 8640 次 = 一直在磨损同一块扇区'
  },
  {
    t: 'CGI 脚本',
    d: '每来一个请求 fork 一个进程。实现简单，但一次请求就要起解释器，A7 上要几十毫秒。',
    bad: '多客户端轮询时 CPU 会被 fork 吃掉'
  },
  {
    t: '常驻 agent（本项目）',
    d: '/proc 是内存里的文件，读一次几毫秒。响应快、不写盘，还顺手承载了 shell 与屏幕推流。',
    bad: '常驻约 9–10MB RSS —— 这是它的代价'
  }
];
---

<Base
  title="运行状态"
  description="开发板实时运行状态：内核版本、CPU 温度、内存、Nginx 进程、隧道状态。数据由板上 board-agent 从 /proc 与 /sys 现读。"
>
  <section class="page-head">
    <div class="container">
      <div class="crumbs">
        <a href="/">首页</a><span>/</span><span>运行状态</span>
      </div>
      <h1>运行状态</h1>
      <p>
        本页用于验证：<strong>内容是否确实由这块开发板提供。</strong>
        下列数据由板端常驻的 <span class="mono">board-agent</span> 在每次请求时
        从 <span class="mono">/proc</span> 与 <span class="mono">/sys</span> 实时读取，
        不落盘、不缓存。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="status-bar">
        <span class="dot-live" id="sb-dot"></span>
        <span id="sb-text">正在读取…</span>
        <span class="mono" id="sb-time">{snapshot.collectedAt}</span>
        <span class="status-bar__sp"></span>
        <span class="mono">source · /agent/api/status · 5s</span>
      </div>

      <div class="table-wrap">
        <table class="tbl">
          <thead>
            <tr><th>字段</th><th>含义</th><th>当前值</th><th>数据来源</th></tr>
          </thead>
          <tbody>
            {fields.map(([k, label, val, src]) => (
              <tr>
                <td class="mono">{k}</td>
                <td>{label}</td>
                <td class="val" id={`st-${k}`}>{val}</td>
                <td class="mono muted">{src}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="small" style="margin-top:14px;">
        agent 不可达时，表格停留在构建时的快照值上，
        <a href="/console/" style="color: var(--brand-dark);">远程控制台</a>
        也会给出明确的失败提示，不会假装在线。
      </p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <SectionHead
        eyebrow="实现"
        title="为何采用常驻 agent 而非定时生成 JSON"
        desc="静态站无法直接获取实时数据，三种方案的实现代价差异显著。"
      />

      <div class="why3">
        {why.map((w, i) => (
          <div class="why3__item">
            <div class="why3__n">{String(i + 1).padStart(2, '0')}</div>
            <h4>{w.t}</h4>
            <p>{w.d}</p>
            <div class="why3__bad mono">{w.bad}</div>
          </div>
        ))}
      </div>

      <p class="small" style="margin-top:22px;">
        选了第三个，是因为这个项目后面还要在网页里开 shell、推屏幕 —— 那两件事必须有常驻进程
        接 WebSocket，状态接口只是「既然进程已经在了」的顺带产物。如果只要状态数据，
        定时写 JSON 更省内存。
      </p>

      <div style="margin-top:30px;">
        <div class="code-label">board-agent.py · 状态采集（节选）</div>
        <pre class="code"><code>{snippet}</code></pre>
      </div>
    </div>
  </section>
</Base>

<style>
  .status-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-bottom: 0;
    border-radius: var(--r) var(--r) 0 0;
    background: var(--soft);
    font-size: 13px;
    color: var(--ink-2);
  }
  .status-bar__sp {
    flex: 1;
  }
  .status-bar .mono {
    font-size: 12px;
    color: var(--muted);
  }
  .dot-live.is-off {
    background: var(--muted);
    box-shadow: 0 0 0 3px rgba(144, 144, 144, 0.16);
  }
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 0 0 var(--r) var(--r);
    background: #fff;
  }
  .tbl {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
  }
  .tbl th,
  .tbl td {
    text-align: left;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
  }
  .tbl thead th {
    background: var(--soft);
    font-size: 12px;
    font-weight: 600;
    color: var(--ink-3);
  }
  .tbl tbody tr:last-child td {
    border-bottom: 0;
  }
  .tbl .val {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--ink);
    font-weight: 600;
  }
  .tbl .muted {
    color: var(--muted);
    font-size: 12px;
  }

  .why3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .why3__item {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: 20px;
  }
  .why3__n {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--brand);
    margin-bottom: 8px;
  }
  .why3__item h4 {
    font-size: 14.5px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .why3__item p {
    font-size: 13px;
    line-height: 1.75;
    color: var(--ink-3);
  }
  .why3__bad {
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px dashed var(--line);
    font-size: 11.5px;
    color: var(--muted);
    line-height: 1.6;
  }

  .code {
    background: var(--navy);
    color: #dbe3ec;
    border-radius: var(--r);
    padding: 20px 22px;
    overflow-x: auto;
    font-size: 12.2px;
    line-height: 1.8;
    margin: 0;
  }
  .code code {
    font-family: var(--mono);
    white-space: pre;
  }
  .code-label {
    font-size: 12px;
    font-family: var(--mono);
    color: var(--muted);
    margin-bottom: 8px;
  }

  @media (max-width: 860px) {
    .why3 {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  (function () {
    function pad(n) { return (n < 10 ? '0' : '') + n; }
    function setText(id, v) {
      var el = document.getElementById(id);
      if (el && v != null && v !== '') el.textContent = v;
    }
    function tick() {
      fetch('/agent/api/status', { cache: 'no-store' })
        .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
        .then(function (d) {
          setText('sb-text', '在线 · ' + d.host + ' · ' + d.arch);
          document.getElementById('sb-dot').className = 'dot-live';
          setText('st-host', d.host);
          setText('st-kernel', d.kernel);
          setText('st-uptime', d.uptime_h);
          setText('st-cpu', (d.cpu == null ? '—' : d.cpu + '%') +
            ' · ' + d.load.map(function (v) { return v.toFixed(2); }).join(' / '));
          setText('st-temp', d.temp == null ? '—' : d.temp + ' °C');
          setText('st-mem', d.mem.used + ' / ' + d.mem.total + ' MB · ' + d.mem.pct + '%');
          setText('st-disk', d.disk.total + ' MB · 已用 ' + d.disk.pct + '%');
          setText('st-nginx', 'nginx ' + d.nginx.ver + ' · ' + d.nginx.workers + ' worker');
          setText('st-tunnel', d.tunnel.up ? 'frp 0.58 · 已连通' : (d.tunnel.state || '未连通'));
          setText('st-procs', d.procs + ' 个');
          setText('st-net', '↑ ' + (d.net.tx / 1048576).toFixed(1) + ' MB · ↓ ' +
            (d.net.rx / 1048576).toFixed(1) + ' MB');
          setText('st-collectedAt', d.time);
          setText('sb-time', d.time);
        })
        .catch(function () {
          document.getElementById('sb-dot').className = 'dot-live is-off';
          setText('sb-text', '板端不可达 · 显示构建时快照');
        });
    }
    tick();
    setInterval(tick, 5000);
  })();
</script>
