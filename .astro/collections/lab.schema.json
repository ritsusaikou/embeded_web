{
  "$ref": "#/definitions/lab",
  "definitions": {
    "lab": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "order": {
          "type": "number"
        },
        "week": {
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "summary": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "duration": {
          "type": "string",
          "default": "4 学时"
        },
        "hardware": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "status": {
          "type": "string",
          "enum": [
            "done",
            "doing",
            "waiting"
          ],
          "default": "done"
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "order",
        "week",
        "date",
        "summary"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}