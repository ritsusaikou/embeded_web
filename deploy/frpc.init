#!/bin/sh
#
# frpc · 把开发板上的静态站点经 frps 反向隧道发布到公网
# 板子是 Yocto + sysvinit，没有 systemd，所以用 LSB 风格的 init 脚本。
#
# 用法：
#   /etc/init.d/frpc start|stop|restart|status
# 开机自启：
#   ln -sf /etc/init.d/frpc /etc/rc5.d/S99frpc

DAEMON=/usr/local/bin/frpc
CONF=/etc/frp/frpc.toml
PIDFILE=/var/run/frpc.pid
LOG=/var/log/frpc.log

is_running() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null
}

case "$1" in
    start)
        if is_running; then
            echo "frpc already running (pid $(cat $PIDFILE))"
            exit 0
        fi
        echo -n "Starting frpc: "
        "$DAEMON" -c "$CONF" >>"$LOG" 2>&1 &
        echo $! >"$PIDFILE"
        sleep 1
        if is_running; then
            echo "ok (pid $(cat $PIDFILE))"
        else
            echo "failed, see $LOG"
            exit 1
        fi
        ;;
    stop)
        if ! is_running; then
            echo "frpc not running"
            rm -f "$PIDFILE"
            exit 0
        fi
        echo -n "Stopping frpc: "
        kill "$(cat $PIDFILE)" 2>/dev/null
        sleep 1
        is_running && kill -9 "$(cat $PIDFILE)" 2>/dev/null
        rm -f "$PIDFILE"
        echo "ok"
        ;;
    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    status)
        if is_running; then
            echo "frpc running (pid $(cat $PIDFILE))"
        else
            echo "frpc stopped"
            exit 1
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
