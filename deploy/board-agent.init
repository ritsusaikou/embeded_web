#!/bin/sh
### BEGIN INIT INFO
# Provides:          board-agent
# Required-Start:    $local_fs $network
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: board-agent · 板端遥测 / PTY shell / 帧缓冲推流
### END INIT INFO
#
# 部署：scp board-agent.init root@板子:/etc/init.d/board-agent
#       chmod 755 /etc/init.d/board-agent
#       ln -sf /etc/init.d/board-agent /etc/rc5.d/S98board-agent
#       ln -sf /etc/init.d/board-agent /etc/rc0.d/K02board-agent
#       ln -sf /etc/init.d/board-agent /etc/rc6.d/K02board-agent

DAEMON=/usr/local/bin/board-agent.py
PIDFILE=/var/run/board-agent.pid
LOGFILE=/var/lib/board-agent/agent.log

is_running() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null
}

find_python() {
    if command -v python3 >/dev/null 2>&1; then
        command -v python3
    else
        echo /usr/bin/python3
    fi
}

case "$1" in
  start)
    if is_running; then
        echo "board-agent already running (pid $(cat $PIDFILE))"
        exit 0
    fi
    mkdir -p /var/lib/board-agent 2>/dev/null
    PY=$(find_python)
    nohup "$PY" "$DAEMON" >>"$LOGFILE" 2>&1 &
    echo $! > "$PIDFILE"
    sleep 1
    if is_running; then
        echo "board-agent started (pid $(cat $PIDFILE))"
    else
        echo "board-agent failed to start, see $LOGFILE"
        exit 1
    fi
    ;;
  stop)
    if is_running; then
        kill "$(cat $PIDFILE)" 2>/dev/null
        rm -f "$PIDFILE"
        echo "board-agent stopped"
    else
        rm -f "$PIDFILE"
        echo "board-agent not running"
    fi
    ;;
  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  status)
    if is_running; then
        echo "board-agent running (pid $(cat $PIDFILE))"
        exit 0
    fi
    echo "board-agent not running"
    exit 3
    ;;
  *)
    echo "usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
